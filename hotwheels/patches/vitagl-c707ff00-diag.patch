diff --git a/Makefile b/Makefile
index 62c532f..b63ed7a 100644
--- a/Makefile
+++ b/Makefile
@@ -16,6 +16,20 @@ CFLAGS  = -g -Wl,-q -O3 -ffast-math -mtune=cortex-a9 -mfpu=neon -Wno-incompatibl
 	-DVGL_GIT_HASH='"$(shell git rev-parse --short HEAD)"' -Isource
 ASFLAGS = $(CFLAGS)
 
+# SPEC-052 (HW-068): variante del build de diagnóstico (V0/V1/V2). Se traduce a número para
+# la línea "[hw] diag" (vgl_diag_variant). El valor por defecto (sin definir) es V0.
+ifneq ($(VGL_DIAG_VARIANT),)
+ifeq ($(VGL_DIAG_VARIANT),V0)
+CFLAGS += -DVGL_DIAG_VARIANT=0
+else ifeq ($(VGL_DIAG_VARIANT),V1)
+CFLAGS += -DVGL_DIAG_VARIANT=1
+else ifeq ($(VGL_DIAG_VARIANT),V2)
+CFLAGS += -DVGL_DIAG_VARIANT=2
+else
+$(error VGL_DIAG_VARIANT invalida: '$(VGL_DIAG_VARIANT)' (V0|V1|V2))
+endif
+endif
+
 ifeq ($(SOFTFP_ABI),1)
 CFLAGS += -mfloat-abi=softfp -DHAVE_SOFTFP_ABI
 endif
