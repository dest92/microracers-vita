index ac4f299..fd07b9b 100644
--- a/src/dynarec86/dyn86.c
+++ b/src/dynarec86/dyn86.c
@@ -84,6 +84,35 @@ uint64_t dyn86_jp_epoch_us = 0;
 uint64_t dyn86_jp_clock_bias_ns = 0;
 uint64_t dyn86_jp_run_us = 0;
 
+/* HW-051: one serialized dynarec publishes a best-effort current guest EIP. */
+static volatile uint32_t guestprof_enabled;
+static volatile uint32_t guestprof_state;
+static volatile uint32_t* guestprof_curblk;
+int box86_dynarec_pcsamp = 0;
+void dyn86_guestprof_enable(int on) {
+    if (on) {
+        __atomic_store_n(&guestprof_state, 0u, __ATOMIC_RELAXED);
+        box86_dynarec_pcsamp = 1;
+        __atomic_store_n(&guestprof_enabled, 1u, __ATOMIC_RELAXED);
+    } else {
+        __atomic_store_n(&guestprof_enabled, 0u, __ATOMIC_RELAXED);
+        __atomic_store_n(&guestprof_state, 0u, __ATOMIC_RELAXED);
+        box86_dynarec_pcsamp = 0;
+    }
+}
+void dyn86_guestprof_set_state(uint32_t state) {
+    if (__atomic_load_n(&guestprof_enabled, __ATOMIC_RELAXED))
+        __atomic_store_n(&guestprof_state, state, __ATOMIC_RELAXED);
+}
+void dyn86_guestprof_bind_curblk(volatile uint32_t* slot) {
+    __atomic_store_n(&guestprof_curblk, slot, __ATOMIC_RELAXED);
+}
+uint32_t dyn86_guestprof_read_state(void) { return __atomic_load_n(&guestprof_state, __ATOMIC_RELAXED); }
+uint32_t dyn86_guestprof_read_eip(void) {
+    volatile uint32_t* slot = __atomic_load_n(&guestprof_curblk, __ATOMIC_RELAXED);
+    return slot ? __atomic_load_n(slot, __ATOMIC_RELAXED) : 0;
+}
