     return tmp;
 }
 
+void arm_fist64_status(double d, x86emu_t* emu)
+{
+    uint64_t bits;
+    memcpy(&bits, &d, sizeof(bits));
+    const uint64_t exponent = (bits >> 52) & 0x7ff;
+    const uint64_t fraction = bits & 0x000fffffffffffffULL;
+    uint16_t raised = 0;
+    if (exponent == 0 && fraction)
+        raised |= 1u << 1; // DE: denormal operand
+
+    double rounded = d;
+    if (!isfinite(d)) {
+        raised |= 1u << 0; // IE: invalid conversion
+    } else {
+        switch ((emu->cw.x16 >> 10) & 3) {
+            case 0: {
+                double low = floor(d);
+                double part = d - low;
+                if (part > 0.5 || (part == 0.5 && fmod(fabs(low), 2.0) != 0.0))
+                    rounded = low + 1.0;
+                else
+                    rounded = low;
+                break;
+            }
+            case 1: rounded = floor(d); break;
+            case 2: rounded = ceil(d); break;
+            default: rounded = trunc(d); break;
+        }
+        if (rounded < -0x1p63 || rounded >= 0x1p63)
+            raised |= 1u << 0;
+        else if (rounded != d)
+            raised |= 1u << 5;
+    }
+    emu->sw.x16 |= raised;
+    if (raised & (uint16_t)~emu->cw.x16 & 0x003f) {
+        emu->sw.f.F87_ES = 1;
+        emu->sw.f.F87_B = 1;
+    }
+    emu->sw.f.F87_C1 = (isfinite(d) && !(raised & 1) && fabs(rounded) > fabs(d));
+}
+
+void arm_fist64_clear_c1(x86emu_t* emu)
+{
+    emu->sw.f.F87_C1 = 0;
+}
