+                block->actual_block=actual_p; block->block=p; block->size=(int)sz;
+                block->x86_size=end-addr; block->hash=hash; block->isize=helper.size;
+                block->instsize=instsize; block->jmpnext=next+sizeof(void*);
+                block->always_test=0; block->dirty=0;
