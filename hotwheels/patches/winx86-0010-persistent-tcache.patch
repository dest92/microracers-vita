@@ -720,6 +754,10 @@ dynarec_log(LOG_DEBUG, "Asked to Fill block %p with %p\n", block, (void*)addr);
         dyn86_jp_x86_insns += (uint64_t)helper.size;
         dyn86_jp_arm_bytes += (uint64_t)oldarmsize;
     }
+    if(!block->always_test)
+        dyn86_tcache_record((uint32_t)block->x86_addr,(void*)DYN86_G2H((uintptr_t)block->x86_addr),
+            (uint32_t)block->x86_size,(const uint8_t*)block->block,(uint32_t)oldarmsize,
+            block->instsize,(uint32_t)block->isize,(uint32_t)(block->isize+2)*sizeof(instsize_t),0);
     current_helper = NULL;
