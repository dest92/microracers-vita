+void dyn86_pmu_set_active(int on) { dyn86_pmu_active = on; }
+void dyn86_pmu_dispatch_reset(void) { dyn86_pmu_dispatch_cycles = 0; dyn86_pmu_dispatch_samples = 0; dyn86_pmu_dispatch_ordinal = 0; }
+uint64_t dyn86_pmu_dispatch_read(void) { return dyn86_pmu_dispatch_cycles * 64ull; }
+uint32_t dyn86_pmu_dispatch_samples_read(void) { return dyn86_pmu_dispatch_samples; }
+#else
+// Keep the shared scheduler linkable on host/qemu builds. PMU access is Vita-only.
+void dyn86_pmu_set_active(int on) { (void)on; }
+void dyn86_pmu_dispatch_reset(void) {}
+uint64_t dyn86_pmu_dispatch_read(void) { return 0; }
+uint32_t dyn86_pmu_dispatch_samples_read(void) { return 0; }
+#endif
