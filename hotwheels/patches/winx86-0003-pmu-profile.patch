+// HW_PMU profiling: count only the C dispatch lookup (DBGetBlock), excluding
+// translated guest instructions. The branch is thread-local and cold unless
+// the opt-in Vita profile is enabled. Counter reads are PMU register accesses,
+// not syscalls; subtraction is modulo 2^32 for one lookup interval.
+#ifdef __vita__
