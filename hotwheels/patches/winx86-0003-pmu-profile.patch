+static __thread uint64_t dyn86_pmu_dispatch_cycles;
+static __thread uint32_t dyn86_pmu_dispatch_samples;
+static __thread uint32_t dyn86_pmu_dispatch_ordinal;
+static inline uint32_t dyn86_pmu_ccnt(void) {
+    uint32_t v; __asm__ volatile("isb\n\tmrc p15,0,%0,c9,c13,0" : "=r"(v) :: "memory"); return v;
