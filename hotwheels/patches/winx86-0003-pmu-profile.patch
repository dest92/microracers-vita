+static inline void pmu_cntenclr(uint32_t v) { __asm__ volatile("mcr p15,0,%0,c9,c12,2" :: "r"(v) : "memory"); }
+static inline void pmu_pmselr(uint32_t v) { __asm__ volatile("mcr p15,0,%0,c9,c12,5" :: "r"(v) : "memory"); __asm__ volatile("isb" ::: "memory"); }
+static inline void pmu_evtyper(uint32_t v) { __asm__ volatile("mcr p15,0,%0,c9,c13,1" :: "r"(v) : "memory"); }
+static inline uint32_t pmu_ccnt() { uint32_t v; __asm__ volatile("mrc p15,0,%0,c9,c13,0" : "=r"(v)); return v; }
+static inline uint32_t pmu_evcnt() { uint32_t v; __asm__ volatile("mrc p15,0,%0,c9,c13,2" : "=r"(v)); return v; }
+static bool pmu_thread_init() {
+    int module_info[2] = {0, 0};
+    if (_vshKernelSearchModuleByName("vpmu", module_info) < 0) {
+        progress("pmu: vpmu.skprx ausente (HW_PMU omitido)"); return false;
+    }
+    const int rc = vpmuEnableUser(1); // refreshes PMUSERENR for this new OS thread too
+    if (rc) {
+        char m[128]; std::snprintf(m, sizeof m, "pmu: sin permiso en hilo (vpmuEnableUser rc=0x%08x)", (unsigned)rc);
+        progress(m); return false;
+    }
+    if (!(vpmuGetUserEnable() & 1u)) {
+        progress("pmu: PMUSERENR no habilitado; contadores omitidos"); return false;
+    }
+    pmu_cntenclr(0x8000003fu);
+    for (unsigned i = 0; i < sizeof kPmuEvents; ++i) {
+        pmu_pmselr(i); pmu_evtyper(kPmuEvents[i]);
+    }
+    return true;
+}
+static void pmu_begin() {
+    pmu_cntenclr(0x8000003fu);
+    pmu_pmcr(0x7u); // enable and reset CCNT + event counters for a bounded slice
+    pmu_cntenset(0x8000003fu);
+}
+static PmuValues pmu_end() {
+    PmuValues v{};
+    pmu_cntenclr(0x8000003fu);
+    v.cycles = pmu_ccnt();
+    for (unsigned i = 0; i < sizeof kPmuEvents; ++i) { pmu_pmselr(i); v.event[i] = pmu_evcnt(); }
+    return v;
+}
+#else
+static bool pmu_thread_init() { return false; }
+static void pmu_begin() {}
+static PmuValues pmu_end() { return {}; }
+#endif
