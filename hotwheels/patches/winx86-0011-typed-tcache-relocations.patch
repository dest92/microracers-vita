+static uint32_t ror32(uint32_t v, unsigned n) { n&=31u; return n ? (v>>n)|(v<<(32u-n)) : v; }
+static int arm_imm_encode(uint32_t value, uint32_t *field) {
+    for(unsigned rot=0;rot<16;rot++) for(unsigned imm=0;imm<256;imm++)
+        if(ror32(imm,2u*rot)==value) { *field=(rot<<8)|imm; return 1; }
+    return 0;
+}
+int dyn86_tcache_apply_fixups(uint8_t *arm, uint32_t arm_size,
+                              const void *raw, uint32_t reloc_count) {
+    const tcache_reloc_t *rel=(const tcache_reloc_t*)raw;
+    if((reloc_count && !rel) || reloc_count>arm_size/4u) return 0;
+    for(uint32_t i=0;i<reloc_count;i++) {
+        uint32_t w;
+        if(arm_size<4u || rel[i].arm_off>arm_size-4u || (rel[i].arm_off&3u)) return 0;
+        memcpy(&w,arm+rel[i].arm_off,4);
+        if(rel[i].type==TC_RELOC_PC_BRANCH) {
+            if((w&0x0e000000u)!=0x0a000000u || (w>>28)==15u || rel[i].value>=arm_size || (rel[i].value&3u)) return 0;
+            int64_t delta=(int64_t)rel[i].value-(int64_t)(rel[i].arm_off+8u);
+            if((delta&3) || delta<-(1<<25) || delta>=(1<<25)) return 0;
+            w=(w&0xff000000u)|((uint32_t)(delta>>2)&0x00ffffffu);
+        } else if(rel[i].type==TC_RELOC_HOST_BASE_ADD) {
+            if((w&0x0c000000u)!=0 || !(w&(1u<<25)) || ((w>>21)&15u)!=4u || ((w>>16)&15u)==15u) return 0;
