+            if(!dyn86_membase || dyn86_membase>UINT32_MAX || !arm_imm_encode((uint32_t)dyn86_membase,&imm)) return 0;
+            w=(w&0xfffff000u)|imm;
+        } else return 0;
+        memcpy(arm+rel[i].arm_off,&w,4);
+    }
+    return 1;
+}
