--- a/src/dynarec86/dyn86.c
+++ b/src/dynarec86/dyn86.c
@@ -84,6 +84,14 @@
 uint64_t dyn86_jp_clock_bias_ns = 0;
 uint64_t dyn86_jp_run_us = 0;
 
+/* SPEC-053 (HW-072): executed guest ARM instructions, fed at the one C-level
+ * funnel (DBGetBlock). Needs WX86_CHAIN=0: with direct linking the TB->TB
+ * transition never reaches C. Off: the DBGetBlock gate is one global load. */
+int dyn86_blkprof = 0;
+uint64_t dyn86_blkprof_total = 0;
+uint64_t dyn86_blkprof_insns(void) { return dyn86_blkprof_total; }
+void dyn86_blkprof_enable(int on) { dyn86_blkprof = on; }
+
 /* HW-051: one serialized dynarec publishes a best-effort current guest EIP. */
