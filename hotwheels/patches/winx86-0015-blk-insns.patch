--- a/src/dynarec86/dyn86.h
+++ b/src/dynarec86/dyn86.h
@@ -130,6 +130,15 @@
 extern uint64_t dyn86_jp_lookup_ns;      /* SAMPLED lookup time (bias removed) */
 extern uint64_t dyn86_jp_lookup_smp;     /* samples actually taken */
 
+/* SPEC-053 (HW-072): executed guest ARM instructions. Fed once per valid block
+ * entry at DBGetBlock (the C funnel), so it needs WX86_CHAIN=0 — with direct
+ * linking the TB->TB transition never reaches C and the count stops growing.
+ * Of a block only its code size is taken (block->size/4): literal pools emitted
+ * inside it count as instructions. Contract and cross-check: SPEC-053. */
+extern int dyn86_blkprof;
+uint64_t dyn86_blkprof_insns(void);
+void dyn86_blkprof_enable(int on);
+
 /* Raise/clear the explicit stop flag (volatile int). */
 void dyn86_set_stop(int v);
 
