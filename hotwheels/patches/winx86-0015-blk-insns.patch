@@ -1014,6 +1017,11 @@
         dt = (dt > dyn86_jp_clock_bias_ns) ? dt - dyn86_jp_clock_bias_ns : 0;
         dyn86_jp_lookup_ns += dt; ++dyn86_jp_lookup_smp;
     }
+    // SPEC-053 (HW-072): a valid block is about to be ENTERED, so its ARM code
